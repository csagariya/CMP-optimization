asreml_vc <- bind_rows(all_asreml_vc)

write.csv(final_all_opt,
          file.path(base_workspace, "All_Scenarios_Optimization_Summary.csv"),
          row.names = FALSE)
write.csv(variance_qc,
          file.path(base_workspace, "Simulation_Variance_QC.csv"),
          row.names = FALSE)
write.csv(asreml_vc,
          file.path(base_workspace, "Fullsib_ASReml_Variance_Components.csv"),
          row.names = FALSE)

# Each row contributing to the CI is one stochastic simulation replicate.
gain_summary <- final_all_opt %>%
    filter(status == "OPTIMAL") %>%
    group_by(h2, dominance_ratio, scenario, ns) %>%
    summarise(
        n_replicates = n_distinct(replicate),
        mean_total = mean(realized_total_gain, na.rm = TRUE),
        se_total = sd(realized_total_gain, na.rm = TRUE) / sqrt(n_replicates),
        ci95_total = 1.96 * se_total,
        mean_gca = mean(realized_gain_gca, na.rm = TRUE),
        se_gca = sd(realized_gain_gca, na.rm = TRUE) / sqrt(n_replicates),
        ci95_gca = 1.96 * se_gca,
        mean_sca = mean(realized_gain_sca, na.rm = TRUE),
        se_sca = sd(realized_gain_sca, na.rm = TRUE) / sqrt(n_replicates),
        ci95_sca = 1.96 * se_sca,
        mean_runtime_sec = mean(elapsed_time_sec, na.rm = TRUE),
        .groups = "drop"
    )

# Strong reproducibility guard against accidental pseudoreplication.
if (any(gain_summary$n_replicates > n_iterations)) {
    stop("CI summary contains more observations than stochastic replicates.", call. = FALSE)
}

write.csv(gain_summary,
          file.path(base_workspace, "Manuscript_Gain_Summary_95CI.csv"),
          row.names = FALSE)

# Relative increase FS100 versus HS, computed from replicate means on the
# corrected GCA scale.
relative_table <- gain_summary %>%
    select(h2, dominance_ratio, scenario, ns, mean_total) %>%
    pivot_wider(names_from = scenario, values_from = mean_total) %>%
    mutate(
        FS100_vs_HS_percent = 100 * (FS100 - HS) / HS
    )

write.csv(relative_table,
          file.path(base_workspace, "FS100_vs_HS_Relative_Increase.csv"),
          row.names = FALSE)

# Optional manuscript-style gain plots: one file for each h2 value.
plot_long <- gain_summary %>%
    select(
        h2, dominance_ratio, scenario, ns,
        mean_total, ci95_total,
        mean_gca, ci95_gca,
        mean_sca, ci95_sca
    ) %>%
    pivot_longer(
        cols = c(mean_total, mean_gca, mean_sca, ci95_total, ci95_gca, ci95_sca),
        names_to = c("stat", "component"),
        names_pattern = "(mean|ci95)_(total|gca|sca)",
        values_to = "value"
    ) %>%
    pivot_wider(names_from = stat, values_from = value)

for (h2_now in sort(unique(plot_long$h2))) {
    pdat <- plot_long %>% filter(h2 == h2_now)

    p <- ggplot(
        pdat,
        aes(x = factor(ns), y = mean, group = component, color = component)
    ) +
        geom_linerange(aes(ymin = mean - ci95, ymax = mean + ci95), linewidth = 0.6) +
        geom_line(linewidth = 0.7) +
        geom_point(size = 2.3) +
        facet_grid(dominance_ratio ~ scenario, scales = "free_y") +
        labs(
            x = "Target status number (Ns)",
            y = "Realized genetic response",
            color = "Component",
            title = paste0("CMP optimization, h2 = ", h2_now)
        ) +
        theme_minimal()

    ggsave(
        file.path(
            base_workspace,
            paste0("Gain_profiles_h2_", gsub("\\.", "p", h2_now), ".png")
        ),
        plot = p,
        width = 12,
        height = 8,
        dpi = 300
    )
