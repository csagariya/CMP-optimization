# =============================================================================
# Manuscript reproduction script
# Optimizing controlled mass pollination in seed orchards:
# exploiting specific combining ability under diversity constraints
# =============================================================================
# Authors: Christi Sagariya, Ye-Ji Kim, Yousry A. El-Kassaby,
#          Milan Lstiburek
#
# This corrected script implements the six genetic-architecture combinations
# described in the manuscript and uses 50 stochastic simulation replicates.
# Each simulated dataset is optimized ONCE per scenario and target Ns.
#
# Quantitative-genetic convention used throughout
# ------------------------------------------------
# Standard diallel GCA is denoted g_i and the expected family deviation is
#
#     g_i + g_j + s_ij.
#
# GCA is therefore NOT divided by two in the optimization objective.
# If breeding values BV_i = 2*g_i are used instead, the algebraically
# equivalent additive term is 0.5*(BV_i + BV_j).
#
# Diversity convention
# --------------------
# A = additive relationship matrix.
# K = A/2 = coancestry matrix.
# p_i = 0.5 * sum_j y_ij.
# Theta = p' K p and Ns = 0.5/Theta.
# Therefore Theta <= 1/(2*Ns).
#
# Genetic-architecture convention
# -------------------------------
# The phenotypic variance is standardized to one at the design level:
#     Va = h2
#     Vd = (Vd/Va) * Va
#     Ve = 1 - Va - Vd
# so h2 = Va/(Va+Vd+Ve) exactly by construction.
# The h2=0.5, Vd/Va=1.0 case therefore has Ve=0, which is the mathematical
# consequence of those two requested parameter values.
#
# MoBPS n.dominant is used (not n.overdominant), because the manuscript states
# that dominance QTL were simulated. The additive and dominance component
# traits are combined WITHOUT re-standardizing the combined trait; otherwise
# the intended Va and Vd components would be destroyed.
# =============================================================================

options(stringsAsFactors = FALSE)

required_packages <- c(
    "RandomFieldsUtils", "miraculix", "MoBPS", "asreml", "dplyr", "tidyr",
    "Matrix", "openxlsx", "gurobi", "ggplot2"
)
missing_packages <- required_packages[
    !vapply(required_packages, requireNamespace, logical(1), quietly = TRUE)
]
if (length(missing_packages) > 0L) {
    stop(
        "Install missing packages before running this workflow: ",
        paste(missing_packages, collapse = ", "),
        call. = FALSE
    )
}

suppressPackageStartupMessages({
    library(RandomFieldsUtils)
    library(miraculix)
    library(MoBPS)
    library(asreml)
    library(dplyr)
    library(tidyr)
    library(Matrix)
    library(openxlsx)
    library(gurobi)
    library(ggplot2)
})

# =============================================================================
# USER SETTINGS
# =============================================================================
base_workspace <- Sys.getenv("CMP_WORKDIR", unset = getwd())
base_workspace <- normalizePath(base_workspace, mustWork = FALSE)
dir.create(base_workspace, recursive = TRUE, showWarnings = FALSE)
setwd(base_workspace)

random_seed <- 12345L

# Simulation scale described in the manuscript.
nf   <- 5000L       # founder individuals
snp  <- 20000L      # SNP markers
ld   <- 100L        # random-mating generations used by founder.simulation
np   <- 100L        # phenotypically selected candidate parents
np_so <- 30L        # seed-orchard parents
nr   <- 5000L       # half-sib progeny
reps_vec <- c(30L, 100L)  # full-sib progeny per cross

n_iterations <- 50L
ns_grid <- c(2, 5, 10, 15, 20)

# Six manuscript parameter combinations.
parameter_grid <- expand.grid(
    h2 = c(0.2, 0.5),
    dominance_ratio = c(0.25, 0.5, 1.0),
    KEEP.OUT.ATTRS = FALSE,
    stringsAsFactors = FALSE
)
parameter_grid <- parameter_grid[order(parameter_grid$h2, parameter_grid$dominance_ratio), ]
row.names(parameter_grid) <- NULL

# QTL counts.
add <- 300L
dom <- 300L

# Solver settings.
gurobi_params <- list(OutputFlag = 0)

# Global output collectors.
all_results <- list()
all_variance_qc <- list()
all_asreml_vc <- list()

# =============================================================================
# STOCHASTIC REPLICATES
# =============================================================================
for (rep_i in seq_len(n_iterations)) {

    cat("\n============================================================\n")
    cat("STOCHASTIC REPLICATE:", rep_i, "of", n_iterations, "\n")
    cat("============================================================\n")

    # One independently simulated founder haplotype population per stochastic
    # replicate. The same founder realization is reused across the six genetic
    # parameter settings within a replicate to improve comparability.
    set.seed(random_seed + rep_i - 1L)

    dataset <- founder.simulation(
        nindi = nf,
        nsnp = snp,
        n.gen = ld,
        sex.quota = 0,
        chr.nr = 4,
        chromosome.length = 1,
        dataset = "random",
        freq = "beta",
        snps.equidistant = TRUE,
        big.output = TRUE,
        plot = FALSE
    )

    for (param_i in seq_len(nrow(parameter_grid))) {

        h2_target <- parameter_grid$h2[param_i]
        dominance_ratio_target <- parameter_grid$dominance_ratio[param_i]

        # Standardize phenotypic variance to one at the design level.
        Va_target <- h2_target
        Vd_target <- dominance_ratio_target * Va_target
        Ve_target <- 1 - Va_target - Vd_target

        if (Ve_target < -1e-12) {
            stop(sprintf(
                "Invalid parameter combination: h2=%.3f, Vd/Va=%.3f gives negative Ve=%.6f.",
                h2_target, dominance_ratio_target, Ve_target
            ), call. = FALSE)
        }
        Ve_target <- max(Ve_target, 0)
        sigma_e_full <- sqrt(Ve_target)  # MoBPS sigma.e is a residual SD.

        h2_label <- gsub("\\.", "p", format(h2_target, trim = TRUE, scientific = FALSE))
        dr_label <- gsub("\\.", "p", format(dominance_ratio_target, trim = TRUE, scientific = FALSE))
        param_tag <- paste0("h2_", h2_label, "_DA_", dr_label)
        param_dir <- file.path(base_workspace, param_tag)

        data_dirs <- file.path(param_dir, c("Data_S1", "Data_S2", "Data_S3", "Data_S4"))
        result_dirs <- file.path(param_dir, c("Results_S1", "Results_S2", "Results_S3", "Results_S4"))
        vapply(c(data_dirs, result_dirs), dir.create, logical(1), recursive = TRUE, showWarnings = FALSE)

        cat("\n------------------------------------------------------------\n")
        cat("Parameter set:", param_tag, "\n")
        cat("Target Va:", Va_target,
            " Target Vd:", Vd_target,
            " Target Ve:", Ve_target,
            "\n")
        cat("------------------------------------------------------------\n")

        # Give every parameter x replicate combination a reproducible stream.
        set.seed(random_seed + rep_i * 1000L + param_i)

        # ---------------------------------------------------------------------
        # 1. Create additive and dominance component traits
        # ---------------------------------------------------------------------
        population <- creating.diploid(
            nindi = nf,
            dataset = dataset[[1]],
            chr.nr = 4,
            nqtl = add + dom,
            chromosome.length = 1,
            sex.quota = 0,
            n.additive = c(add, 0),
            n.dominant = c(0, dom),
            n.overdominant = c(0, 0),
            mean.target = c(0, 0),
            base.bv = c(0, 0),
            var.target = c(Va_target, Vd_target),
            trait.name = c("add", "dom"),
            name.cohort = paste0("Founders_", rep_i, "_", param_i)
        )

        founder_cohort <- paste0("Founders_", rep_i, "_", param_i)
        parent_cohort <- paste0("Parents_", rep_i, "_", param_i)
        hs_cohort <- paste0("Half_sib_", rep_i, "_", param_i)

        # Relationship matrix returned with the simulated founder haplotypes.
        A_all <- dataset[[4]]
        id_nf <- as.character(get.id(population, cohorts = founder_cohort))
        dimnames(A_all) <- list(id_nf, id_nf)

        # Combine component QTL effects WITHOUT standardizing the combined trait.
        qtls_components <- get.qtl.effects(population)
        full_trait_qtl <- rbind(qtls_components[[1]][[1]], qtls_components[[1]][[2]])

        population <- creating.trait(
            population,
            real.bv.add = full_trait_qtl,
            trait.name = "Full_trait",
            base.bv = 0,
            bv.standard = FALSE
        )

        # QA: record realized component variances in the founder population.
        founder_bv <- t(get.bv(population, cohorts = founder_cohort))
        if (ncol(founder_bv) < 3L) {
            stop("Expected additive, dominance, and Full_trait genomic values from MoBPS.", call. = FALSE)
        }

        Va_realized <- var(as.numeric(founder_bv[, 1]), na.rm = TRUE)
        Vd_realized <- var(as.numeric(founder_bv[, 2]), na.rm = TRUE)
        Vg_full_realized <- var(as.numeric(founder_bv[, 3]), na.rm = TRUE)
        realized_component_ratio <- Vd_realized / Va_realized
        realized_founder_h2_qc <- Va_realized / (Vg_full_realized + Ve_target)

        all_variance_qc[[length(all_variance_qc) + 1L]] <- data.frame(
            replicate = rep_i,
            h2_target = h2_target,
            dominance_ratio_target = dominance_ratio_target,
            Va_target = Va_target,
            Vd_target = Vd_target,
            Ve_target = Ve_target,
            Va_realized_component = Va_realized,
            Vd_realized_component = Vd_realized,
            Vg_full_realized = Vg_full_realized,
            dominance_ratio_realized_component = realized_component_ratio,
            h2_realized_founder_QC = realized_founder_h2_qc,
            stringsAsFactors = FALSE
        )

        # ---------------------------------------------------------------------
        # 2. Phenotype founders and select 100 candidate parents
        # ---------------------------------------------------------------------
        population <- breeding.diploid(
            population,
            sigma.e = c(0, 0, sigma_e_full),
            phenotyping.cohorts = founder_cohort,
            n.observation = c(0, 0, 1)
        )

        population <- breeding.diploid(
            population,
            selection.size = c(np, 0),
            selection.criteria = "pheno",
            selection.m.cohorts = founder_cohort,
            selection.index.weights.m = c(0, 0, 1),
            copy.individual = TRUE,
            name.cohort = parent_cohort
        )

        id_parents <- as.character(get.id(population, cohorts = parent_cohort))

        # ---------------------------------------------------------------------
        # 3. Half-sib progeny test
        # ---------------------------------------------------------------------
        # selection.m.* in MoBPS denotes the first/paternal parent. Therefore
        # the half-sib family is defined by father, not mother.
        population <- breeding.diploid(
            population,
            breeding.size = nr,
            breeding.sex = 0,
            selection.m.cohorts = parent_cohort,
            name.cohort = hs_cohort
        )

        population <- breeding.diploid(
            population,
            phenotyping.cohorts = hs_cohort,
            n.observation = c(0, 0, 1)
        )

        ped_hs <- get.pedigree(population, cohorts = hs_cohort)
        ph_hs <- t(get.pheno(population, cohorts = hs_cohort))
        if ("Full_trait" %in% colnames(ph_hs)) {
            y_hs <- as.numeric(ph_hs[, "Full_trait"])
        } else {
            y_hs <- as.numeric(ph_hs[, 3])
        }

        data_hs <- data.frame(
            offspring = as.character(ped_hs[, 1]),
            father = as.character(ped_hs[, 2]),
            mother = "0",
            Full_trait = y_hs,
            stringsAsFactors = FALSE
        )
        data_hs$family <- data_hs$father

        # ASReml factors.
        data_hs$offspring <- as.factor(data_hs$offspring)
        data_hs$father <- as.factor(data_hs$father)
        data_hs$mother <- as.factor(data_hs$mother)
        data_hs$family <- as.factor(data_hs$family)

        ainv_hs <- ainverse(pedigree = data_hs[, c("offspring", "father", "mother")])

        # The fitted family effects are standard GCA effects g_i (half of BV).
        mod_hs <- asreml(
            fixed = Full_trait ~ 1,
            random = ~ vm(family, ainv_hs),
            residual = ~ idv(units),
            na.action = na.method(y = "include"),
            maxit = 100,
            workspace = 1e09,
            data = data_hs
        )

        blup_hs <- as.data.frame(summary(mod_hs, coef = TRUE)$coef.random)
        blup_hs$ID <- sub("^vm\\(family, ainv_hs\\)_", "", rownames(blup_hs))
        blup_par <- blup_hs[blup_hs$ID %in% id_parents, , drop = FALSE]
        blup_par$GCA <- blup_par$solution

        if (nrow(blup_par) < np_so) {
            stop(sprintf(
                "Only %d candidate-parent GCA solutions were available; need %d.",
                nrow(blup_par), np_so
            ), call. = FALSE)
        }

        top_30 <- blup_par[order(blup_par$GCA, decreasing = TRUE), , drop = FALSE]
        top_30 <- top_30[seq_len(np_so), , drop = FALSE]
        id_top_30 <- as.character(top_30$ID)

        df_hs_top <- data.frame(
            replicate = rep_i,
            ID = id_top_30,
            GCA = top_30$GCA,
            stringsAsFactors = FALSE
        )
        sca_hs_top <- matrix(0, nrow = np_so, ncol = np_so,
                             dimnames = list(id_top_30, id_top_30))

        # ---------------------------------------------------------------------
        # 4. True cross means, true GCA, and true SCA for selected 30 parents
        # ---------------------------------------------------------------------
        effects <- get.qtl.effects(population)[[1]][[3]]
        g0 <- effects[, 3]
        g1 <- effects[, 4]
        g2 <- effects[, 5]
        qtl_idx <- effects[, 6]

        a_eff <- (g2 - g0) / 2
        d_eff <- g1 - (g0 + g2) / 2
        midpoint_eff <- (g0 + g2) / 2

        geno_par <- get.geno(population, cohorts = parent_cohort)
        geno_par <- geno_par[, id_top_30, drop = FALSE]
        Gq_par <- geno_par[qtl_idx, , drop = FALSE]

        ids <- colnames(Gq_par)
        n <- length(ids)
        gamete_p <- Gq_par / 2

        true_cross_mean <- matrix(NA_real_, n, n, dimnames = list(ids, ids))
        for (u in seq_len(n)) {
            for (v in u:n) {
                pu <- gamete_p[, u]
                pv <- gamete_p[, v]
                het_prob <- pu * (1 - pv) + (1 - pu) * pv

                # Expected progeny genotypic value at each QTL:
                # midpoint + a*(P2-P0) + d*P1.
                val <- sum(
                    midpoint_eff +
                    a_eff * (pu + pv - 1) +
                    d_eff * het_prob
                )

                true_cross_mean[u, v] <- val
                true_cross_mean[v, u] <- val
            }
        }

        tmp <- true_cross_mean
        diag(tmp) <- NA_real_
        mu_true <- mean(tmp[upper.tri(tmp, diag = FALSE)], na.rm = TRUE)

        # Standard GCA effect, not breeding value.
        gca_true <- rowMeans(tmp, na.rm = TRUE) - mu_true
        names(gca_true) <- ids

        true_sca <- matrix(0, n, n, dimnames = list(ids, ids))
        for (u in 1:(n - 1L)) {
            for (v in (u + 1L):n) {
                s_uv <- true_cross_mean[u, v] - mu_true - gca_true[u] - gca_true[v]
                true_sca[u, v] <- s_uv
                true_sca[v, u] <- s_uv
            }
        }
        diag(true_sca) <- 0

        df_true <- data.frame(
            replicate = rep_i,
            ID = ids,
            GCA = as.numeric(gca_true),
            stringsAsFactors = FALSE
        )

        # Additive relationship matrix for selected parents.
        if (!all(id_top_30 %in% rownames(A_all))) {
            stop("Selected parent IDs were not found in the founder relationship matrix.", call. = FALSE)
        }
        A_top <- A_all[id_top_30, id_top_30, drop = FALSE]
        A_top <- (A_top + t(A_top)) / 2

        # Save scenario 1 and 2 inputs.
        write.csv(A_top,
                  file.path(data_dirs[1], sprintf("A_matrix_rep_%02d.csv", rep_i)),
                  row.names = TRUE)
        write.csv(df_true,
                  file.path(data_dirs[1], sprintf("GCA_true_rep_%02d.csv", rep_i)),
                  row.names = FALSE)
        write.csv(true_sca,
                  file.path(data_dirs[1], sprintf("SCA_true_rep_%02d.csv", rep_i)),
                  row.names = TRUE)
        write.csv(df_hs_top,
                  file.path(data_dirs[2], sprintf("GCA_half_sib_rep_%02d.csv", rep_i)),
                  row.names = FALSE)
        write.csv(sca_hs_top,
                  file.path(data_dirs[2], sprintf("SCA_half_sib_rep_%02d.csv", rep_i)),
                  row.names = TRUE)

        # ---------------------------------------------------------------------
        # 5. Full-sib half-diallel progeny tests: 30 and 100 per cross
        # ---------------------------------------------------------------------
        fs_gca <- list()
        fs_sca <- list()

        for (k_rep in reps_vec) {

            fullsib_cohort <- paste0(
                "Full_sib_", k_rep, "_", rep_i, "_", param_i
            )

            database_selected <- get.database(population, id = id_top_30)

            population <- breeding.diploid(
                population,
                breeding.all.combination = TRUE,
                selection.m.database = database_selected,
                selection.size = c(np_so, 0),
                breeding.sex = 0,
                repeat.mating = k_rep,
                name.cohort = fullsib_cohort
            )

            population <- breeding.diploid(
                population,
                phenotyping.cohorts = fullsib_cohort,
                n.observation = c(0, 0, 1)
            )

            ped_off <- get.pedigree(population, cohorts = fullsib_cohort)
            pheno_off <- t(get.pheno(population, cohorts = fullsib_cohort))
            df1 <- as.data.frame(cbind(ped_off, pheno_off), stringsAsFactors = FALSE)

            if (!"Full_trait" %in% names(df1)) {
                stop("Full_trait phenotype column was not returned for the full-sib cohort.", call. = FALSE)
            }

            p1 <- pmin(as.character(df1$father), as.character(df1$mother))
            p2 <- pmax(as.character(df1$father), as.character(df1$mother))
            df1$cross <- paste0(p1, "_X_", p2)

            observed_crosses <- unique(df1$cross)
            expected_crosses <- choose(np_so, 2)
            if (length(observed_crosses) != expected_crosses) {
                stop(sprintf(
                    "Expected %d unique non-self full-sib families but MoBPS generated %d. Check mating settings.",
                    expected_crosses, length(observed_crosses)
                ), call. = FALSE)
            }

            df1$father <- as.factor(df1$father)
            df1$mother <- as.factor(df1$mother)
            df1$offspring <- as.factor(df1$offspring)
            df1$cross <- as.factor(df1$cross)

            ped1 <- df1[, c("offspring", "father", "mother")]
            ainv1 <- ainverse(pedigree = ped1)

            # Overlay mother and father design matrices so each parent has one
            # shared GCA effect. The fitted coefficient is standard GCA g_i.
            mod1 <- asreml(
                fixed = Full_trait ~ 1,
                random = ~ vm(mother, ainv1) + and(vm(father, ainv1)) + cross,
                equate.levels = c("mother", "father"),
                residual = ~ idv(units),
                na.action = na.method(y = "include"),
                maxit = 100,
                workspace = 1e09,
                data = df1
            )

            coef_random <- as.data.frame(summary(mod1, coef = TRUE)$coef.random)

            # With overlay, one combined parental coefficient set is returned
            # under the first (mother) model term.
            gca_rows <- grep("^vm\\(mother, ainv1\\)_", rownames(coef_random))
            blup_gca <- coef_random[gca_rows, , drop = FALSE]
            blup_gca$ID <- sub("^vm\\(mother, ainv1\\)_", "", rownames(blup_gca))

            df_fs <- data.frame(ID = id_top_30, stringsAsFactors = FALSE)
            df_fs <- left_join(
                df_fs,
                blup_gca[, c("ID", "solution")],
                by = "ID"
            )
            names(df_fs)[2] <- "GCA"
            df_fs$GCA[is.na(df_fs$GCA)] <- 0

            sca_rows <- grep("^cross_", rownames(coef_random))
            blup_family <- coef_random[sca_rows, , drop = FALSE]
            blup_family$ID <- sub("^cross_", "", rownames(blup_family))
            blup_family <- blup_family %>%
                separate(ID, into = c("parent1", "parent2"), sep = "_X_", remove = FALSE)
            blup_family$SCA <- blup_family$solution

            sca_matrix <- matrix(0, nrow = np_so, ncol = np_so,
                                 dimnames = list(id_top_30, id_top_30))
            if (nrow(blup_family) > 0L) {
                upper_idx <- as.matrix(blup_family[, c("parent1", "parent2")])
                lower_idx <- as.matrix(blup_family[, c("parent2", "parent1")])
                sca_matrix[upper_idx] <- blup_family$SCA
                sca_matrix[lower_idx] <- blup_family$SCA
            }
            diag(sca_matrix) <- 0

            fs_gca[[as.character(k_rep)]] <- df_fs
            fs_sca[[as.character(k_rep)]] <- sca_matrix

            out_data_dir <- if (k_rep == 30L) data_dirs[3] else data_dirs[4]
            write.csv(
                df_fs,
                file.path(out_data_dir, sprintf("GCA_full_sib_%d_rep_%02d.csv", k_rep, rep_i)),
                row.names = FALSE
            )
            write.csv(
                sca_matrix,
                file.path(out_data_dir, sprintf("SCA_full_sib_%d_rep_%02d.csv", k_rep, rep_i)),
                row.names = TRUE
            )

            vc <- summary(mod1)$varcomp
            all_asreml_vc[[length(all_asreml_vc) + 1L]] <- data.frame(
                replicate = rep_i,
                h2_target = h2_target,
                dominance_ratio_target = dominance_ratio_target,
                progeny_per_cross = k_rep,
                V_GCA_effect = vc[1, 1],
                V_SCA_effect = vc[2, 1],
                V_residual = vc[3, 1],
                SCA_to_GCA_effect_variance_ratio = vc[2, 1] / vc[1, 1],
                stringsAsFactors = FALSE
            )
        }

        # ---------------------------------------------------------------------
        # 6. CMP optimization: one deterministic solve per dataset/scenario/Ns
        # ---------------------------------------------------------------------
        scenario_names <- c("TRUE", "HS", "FS30", "FS100")

        for (scenario_i in seq_along(scenario_names)) {

            scenario <- scenario_names[scenario_i]
            result_dir <- result_dirs[scenario_i]

            if (scenario == "TRUE") {
                gca_est <- gca_true
                sca_est <- true_sca
                decision_mode <- "GCA+SCA"
            } else if (scenario == "HS") {
                gca_est <- df_hs_top$GCA
                names(gca_est) <- df_hs_top$ID
                sca_est <- sca_hs_top
                decision_mode <- "GCA_only"
            } else if (scenario == "FS30") {
                gca_est <- fs_gca[["30"]]$GCA
                names(gca_est) <- fs_gca[["30"]]$ID
                sca_est <- fs_sca[["30"]]
                decision_mode <- "GCA+SCA"
            } else {
                gca_est <- fs_gca[["100"]]$GCA
                names(gca_est) <- fs_gca[["100"]]$ID
                sca_est <- fs_sca[["100"]]
                decision_mode <- "GCA+SCA"
            }

            common_ids <- Reduce(
                intersect,
                list(
                    rownames(A_top),
                    names(gca_true),
                    rownames(true_sca),
                    names(gca_est),
                    rownames(sca_est)
                )
            )
            if (length(common_ids) != np_so) {
                stop(sprintf(
                    "Expected %d common seed-orchard parent IDs, found %d in %s.",
                    np_so, length(common_ids), scenario
                ), call. = FALSE)
            }

            # Additive relationship A -> coancestry K=A/2.
            K_set <- A_top[common_ids, common_ids, drop = FALSE] / 2
            K_set <- (K_set + t(K_set)) / 2

            eig <- eigen(K_set, symmetric = TRUE)
            min_eig <- min(eig$values)
            if (min_eig < -1e-7) {
                stop(sprintf(
                    "Coancestry matrix is not PSD (min eigenvalue %.6g).",
                    min_eig
                ), call. = FALSE)
            }
            if (min_eig < 0) {
                eig$values[eig$values < 0] <- 0
                K_set <- eig$vectors %*%
                    diag(eig$values, nrow = length(eig$values)) %*%
                    t(eig$vectors)
                K_set <- (K_set + t(K_set)) / 2
                dimnames(K_set) <- list(common_ids, common_ids)
            }

            gca_true_set <- gca_true[common_ids]
            sca_true_set <- true_sca[common_ids, common_ids, drop = FALSE]
            gca_est_set <- gca_est[common_ids]
            sca_est_set <- sca_est[common_ids, common_ids, drop = FALSE]

            sca_true_set <- (sca_true_set + t(sca_true_set)) / 2
            sca_est_set <- (sca_est_set + t(sca_est_set)) / 2
            diag(sca_true_set) <- 0
            diag(sca_est_set) <- 0

            if (decision_mode == "GCA_only") {
                sca_est_set[,] <- 0
            }

            n_parents <- length(common_ids)
            family_map <- combn(n_parents, 2)
            n_families <- ncol(family_map)

            M <- Matrix(0, nrow = n_parents, ncol = n_families, sparse = TRUE)
            cross_gca_est <- numeric(n_families)
            cross_sca_est <- numeric(n_families)
            cross_obj_est <- numeric(n_families)
            cross_gca_true <- numeric(n_families)
            cross_sca_true <- numeric(n_families)

            for (f in seq_len(n_families)) {
                ii <- family_map[1, f]
                jj <- family_map[2, f]
                id_i <- common_ids[ii]
                id_j <- common_ids[jj]

                M[ii, f] <- 0.5
                M[jj, f] <- 0.5

                # CORRECT standard-GCA scaling.
                cross_gca_est[f] <- gca_est_set[id_i] + gca_est_set[id_j]
                cross_sca_est[f] <- sca_est_set[id_i, id_j]
                cross_obj_est[f] <- cross_gca_est[f] + cross_sca_est[f]

                cross_gca_true[f] <- gca_true_set[id_i] + gca_true_set[id_j]
                cross_sca_true[f] <- sca_true_set[id_i, id_j]
            }

            Qc <- as.matrix(t(M) %*% K_set %*% M)
            Qc <- (Qc + t(Qc)) / 2

            for (ns in ns_grid) {

                model <- list()
                model$obj <- cross_obj_est
                model$modelsense <- "max"
                model$A <- matrix(1, nrow = 1, ncol = n_families)
                model$rhs <- 1
                model$sense <- "="
                model$lb <- rep(0, n_families)
                model$ub <- rep(1, n_families)
                model$quadcon <- list(list(
                    Qc = Qc,
                    rhs = 1 / (2 * ns),
                    sense = "<="
                ))

                time_start <- Sys.time()
                res <- gurobi(model, gurobi_params)
                elapsed_time_sec <- as.numeric(
                    difftime(Sys.time(), time_start, units = "secs")
                )

                if (!is.null(res$status) && res$status == "OPTIMAL") {
                    Y_opt <- res$x
                    p_opt <- as.vector(M %*% Y_opt)
                    active_cross_idx <- which(Y_opt > 1e-8)

                    predicted_gain_gca <- sum(Y_opt * cross_gca_est)
                    predicted_gain_sca <- sum(Y_opt * cross_sca_est)
                    predicted_total_gain <- predicted_gain_gca + predicted_gain_sca

                    realized_gain_gca <- sum(Y_opt * cross_gca_true)
                    realized_gain_sca <- sum(Y_opt * cross_sca_true)
                    realized_total_gain <- realized_gain_gca + realized_gain_sca

                    theta <- as.numeric(t(p_opt) %*% K_set %*% p_opt)
                    realized_ns <- 0.5 / theta

                    # Algebraic check for the standard-GCA scale:
                    # sum y_ij(g_i+g_j) = 2 sum p_i g_i.
                    realized_gca_check <- 2 * sum(p_opt * gca_true_set)
                    if (abs(realized_gain_gca - realized_gca_check) > 1e-7) {
                        stop("GCA scaling consistency check failed.", call. = FALSE)
                    }

                    summary_now <- data.frame(
                        replicate = rep_i,
                        h2 = h2_target,
                        dominance_ratio = dominance_ratio_target,
                        scenario = scenario,
                        ns = ns,
                        decision_mode = decision_mode,
                        status = res$status,
                        elapsed_time_sec = elapsed_time_sec,
                        objective_estimated = res$objval,
                        predicted_gain_gca = predicted_gain_gca,
                        predicted_gain_sca = predicted_gain_sca,
                        predicted_total_gain = predicted_total_gain,
                        realized_gain_gca = realized_gain_gca,
                        realized_gain_sca = realized_gain_sca,
                        realized_total_gain = realized_total_gain,
                        group_coancestry = theta,
                        diversity_limit = 1 / (2 * ns),
                        realized_ns = realized_ns,
                        n_active_crosses = length(active_cross_idx),
                        n_active_parents = sum(p_opt > 1e-8),
                        stringsAsFactors = FALSE
                    )

                    y_now <- data.frame(
                        Parent1 = common_ids[family_map[1, active_cross_idx]],
                        Parent2 = common_ids[family_map[2, active_cross_idx]],
                        Y = Y_opt[active_cross_idx],
                        estimated_GCA_component = cross_gca_est[active_cross_idx],
                        estimated_SCA_component = cross_sca_est[active_cross_idx],
                        true_GCA_component = cross_gca_true[active_cross_idx],
                        true_SCA_component = cross_sca_true[active_cross_idx],
                        stringsAsFactors = FALSE
                    )

                    p_now <- data.frame(
                        Parent_ID = common_ids,
                        p = p_opt,
                        stringsAsFactors = FALSE
                    )

                } else {
                    summary_now <- data.frame(
                        replicate = rep_i,
                        h2 = h2_target,
                        dominance_ratio = dominance_ratio_target,
                        scenario = scenario,
                        ns = ns,
                        decision_mode = decision_mode,
                        status = ifelse(is.null(res$status), "FAILED", res$status),
                        elapsed_time_sec = elapsed_time_sec,
                        objective_estimated = NA_real_,
                        predicted_gain_gca = NA_real_,
                        predicted_gain_sca = NA_real_,
                        predicted_total_gain = NA_real_,
                        realized_gain_gca = NA_real_,
                        realized_gain_sca = NA_real_,
                        realized_total_gain = NA_real_,
                        group_coancestry = NA_real_,
                        diversity_limit = 1 / (2 * ns),
                        realized_ns = NA_real_,
                        n_active_crosses = NA_integer_,
                        n_active_parents = NA_integer_,
                        stringsAsFactors = FALSE
                    )
                    y_now <- data.frame()
                    p_now <- data.frame()
                }

                all_results[[length(all_results) + 1L]] <- summary_now

                # One workbook per stochastic dataset/scenario/Ns. There is no
                # repeated deterministic "optimization iteration" dimension.
                ns_dir <- file.path(
                    result_dir,
                    sprintf("Rep_%02d", rep_i),
                    sprintf("Ns_%02d", ns)
                )
                dir.create(ns_dir, recursive = TRUE, showWarnings = FALSE)

                wb <- createWorkbook()
                addWorksheet(wb, "Summary")
                writeData(wb, "Summary", summary_now)
                addWorksheet(wb, "Families_Y")
                writeData(wb, "Families_Y", y_now)
                addWorksheet(wb, "Parents_p")
                writeData(wb, "Parents_p", p_now)
                saveWorkbook(
                    wb,
                    file.path(ns_dir, sprintf("%s_rep_%02d_Ns_%02d.xlsx", scenario, rep_i, ns)),
                    overwrite = TRUE
                )
            }
        }

        cat("Completed", param_tag, "replicate", rep_i, "\n")
    }
}

